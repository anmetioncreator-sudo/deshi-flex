// Prisma Schema for DESHI FLEX E-Commerce & Custom Apparel Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  desc      String    @default("")
  bg        String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  price         Float
  originalPrice Float?
  description   String    @default("")
  categorySlug  String?
  category      Category? @relation(fields: [categorySlug], references: [slug], onDelete: SetNull)
  photoUrl      String?
  images        String    @default("[]") // JSON string of image URLs
  colors        String    @default("[]") // JSON string of colors [{name, hex}]
  sizes         String    @default("[]") // JSON string of sizes ["M", "L", "XL"]
  inventory     String    @default("{}") // JSON string of inventory mapping
  costPrice     Float?    @default(0)
  totalStock    Int       @default(0)
  stockCount    Int       @default(0)
  lowStockAlert Int       @default(5)
  inStock       Boolean   @default(true)
  rating        Float     @default(5.0)
  reviewsCount  Int       @default(0)
  isNew         Boolean   @default(false)
  isSale        Boolean   @default(false)
  tagline       String?
  details       String    @default("[]") // JSON string of bullet details
  reviews       Review[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Order {
  id               String   @id // e.g. "ORD-1234"
  type             String   // "Standard Custom" | "Full Image Custom" | "Direct Checkout"
  date             DateTime @default(now())
  
  // Customer Details
  fullName         String
  email            String?
  phone            String
  address          String
  region           String
  ipAddress        String?  // Client IP for anti-cheat/anti-spam rate limiting


  
  // Custom Design attributes
  designType       String?  // "Drop Shoulder" | "Custom Design Drop Shoulder"
  referenceImage   String?
  frontImageName   String?
  backImageName    String?
  frontImagePos    String?  // JSON string {x, y, scale}
  backImagePos     String?  // JSON string {x, y, scale}
  frontPrintSize   String?
  backPrintSize    String?
  color            String?
  materials        String?
  description      String?
  
  // Direct Checkout & Cart items
  itemId           String?
  quantity         Int?     @default(1)
  specialNotes     String?
  cartItems        String?  // JSON string of items in order
  
  // Payment Details
  advancePaid      Float    @default(0)
  trxId            String   @default("")
  remainingBalance Float    @default(0)
  
  // Status Tracking
  status           String   @default("Pending Verification") // "Pending Verification" | "Processing" | "Shipped" | "Delivered" | "Cancelled"
  statusNote       String?
  deleted          Boolean  @default(false)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  rating    Int      @default(5)
  comment   String?
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SiteSetting {
  id          String   @id @default("default")
  heroImages  String   @default("[]") // JSON string array of URLs
  forHimImage String?
  forHerImage String?
  updatedAt   DateTime @updatedAt
}

model StockLog {
  id            String   @id @default(cuid())
  productId     String
  productName   String
  type          String   // "RESTOCK" | "SALE" | "DAMAGE" | "RETURN" | "CORRECTION"
  quantity      Int      // positive for additions, negative for deductions
  previousStock Int
  newStock      Int
  costPerUnit   Float?
  note          String?
  createdAt     DateTime @default(now())
}

model ExpenseLog {
  id            String   @id @default(cuid())
  title         String
  category      String   // "Fabric/Materials" | "Printing/Dyeing" | "Packaging" | "Marketing/Ads" | "Delivery/Courier" | "Operational/Rent" | "Other"
  amount        Float
  paymentMethod String   @default("Cash") // "Cash" | "bKash" | "Nagad" | "Bank"
  date          DateTime @default(now())
  note          String?
  createdAt     DateTime @default(now())
}

model SaleLog {
  id            String   @id @default(cuid())
  orderId       String?  // Linked Order ID if from storefront
  channel       String   @default("Online Store") // "Online Store" | "Direct / POS" | "Facebook / WhatsApp" | "Wholesale"
  customerName  String
  customerPhone String?
  items         String   // JSON array [{ productId, name, size, color, quantity, unitPrice, costPrice }]
  totalAmount   Float
  costAmount    Float    @default(0)
  profitAmount  Float    @default(0)
  paymentMethod String   @default("COD") // "COD" | "bKash" | "Nagad" | "Cash" | "Bank"
  paymentStatus String   @default("Paid") // "Paid" | "Partial" | "Due"
  note          String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  password  String?  // Hashed with bcryptjs
  role      String   @default("customer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

