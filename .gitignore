# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Large design source files & backups
/CLOTHING DESIN/
/src_backup/

# Databases
*.db
*.db-journal
prisma/*.db

# User uploads & temp root files
/public/uploads/*
!/public/uploads/.gitkeep
/front_rgba.png
/back_rgba.png
/logo-b64.txt


.vercel
.env*
